{
  "name": "electrical-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electrical cable and installation design tool (IEC / BS / NEC)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest": "python3 tools/pdf-ingest/ingest.py",
    "ingest:validate": "python3 tools/pdf-ingest/validate.py",
    "size": "tsx tools/size-circuit.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "@ed/core": "workspace:*",
    "tsx": "^4.19.0"
  }
}
